.pnpm-debug.log*
lerna-debug.log*

# package-lock.json must stay IN the build context. The Dockerfile copies it and

# runs `npm ci`, which fails without it - excluding it here is what would break

# the image build. The other two lockfiles are unused and stay out.

yarn.lock
pnpm-lock.yaml

